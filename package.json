{
  "name": "web-presentacion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D cylindrical company wheel for the corporate group presentation site.",
  "scripts": {
    "predev": "node scripts/scan-covers.mjs && node scripts/scan-portfolio.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/scan-covers.mjs && node scripts/scan-portfolio.mjs",
    "build": "next build",
    "covers:scan": "node scripts/scan-covers.mjs",
    "portfolio:scan": "node scripts/scan-portfolio.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "logos:optimize": "node scripts/optimize-logos.mjs",
    "colors:extract": "node scripts/extract-colors.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "gsap": "3.15.0",
    "next": "15.5.25",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
